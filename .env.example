# Copy to .env.local and fill in. Never commit the filled-in file.

# The Movie Database — used ONLY by scripts/fetch-films.mjs at development
# time to resolve poster paths into data/films.ts. It is never read by the
# app at runtime and never reaches the client bundle, so a fresh clone can
# build and deploy without it as long as data/films.ts is committed.
#
# Get one free: https://www.themoviedb.org/settings/api  (API Read Access Token)
TMDB_READ_TOKEN=
